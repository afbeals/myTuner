# Copy this file to .env and fill in real values. .env is git-ignored.

# Unraid share paths — must be /mnt/user/<share>/..., never /mnt/diskN/... or
# /mnt/user0/... (see INVESTIGATION.md, "Unraid mount strategy").
ERSATZTV_CONFIG_PATH=/mnt/user/appdata/ersatztv
SHARED_LIBRARY_PATH=/mnt/user/media/Shows
PRIVATE_LIBRARY_PATH=/mnt/user/media/Private

# Private-channel reverse proxy
PROXY_PORT=8443
# Generate with: openssl rand -hex 32
PRIVATE_CHANNEL_TOKEN=changeme

# ErsatzTV API key — NOT in a Settings page. ErsatzTV auto-generates this on first run
# into api-secrets.json inside its config folder (ERSATZTV_CONFIG_PATH above), e.g.:
#   cat /mnt/user/appdata/ersatztv/api-secrets.json
# Only needed if the chapter generator's --ersatztv-api-key / rescan trigger is used.
ERSATZTV_API_KEY=
