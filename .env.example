# Paths must be real existing directories accessible to runtime UID/GID (default node:1000).
# Keep app data on a local Unraid appdata pool; replace YOUR_POOL explicitly.
MYTUNER_DATA_PATH=/mnt/YOUR_POOL/appdata/mytuner/data
MYTUNER_GENERATED_PATH=/mnt/YOUR_POOL/appdata/mytuner/generated
MYTUNER_CACHE_PATH=/mnt/YOUR_POOL/appdata/mytuner/cache
# Use existing user shares for media; these are mounted read-only.
MYTUNER_MEDIA_PATH=/mnt/user/media
MYTUNER_COMMERCIALS_PATH=/mnt/user/commercials
MYTUNER_PORT=8777
MYTUNER_VERSION=0.2.0
# Set only to the intended, tested runtime identity; source shares remain read-only.
MYTUNER_UID=1000
MYTUNER_GID=1000
# Shared non-preemptive FFmpeg process budget (2–8); one slot is reserved from optional background work.
MYTUNER_ENCODER_CONCURRENCY=3

# Optional, only when using an HTTPS reverse proxy. Keep blank for direct LAN HTTP.
MYTUNER_PUBLIC_ORIGIN=
MYTUNER_SECURE_COOKIE=false

# Metadata retention (whole days, 1–365). Originals are never deleted.
MYTUNER_COLLECTION_RETENTION_DAYS=7
MYTUNER_REPORT_RETENTION_DAYS=30
